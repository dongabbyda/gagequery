{
  "name": "gagequery",
  "version": "0.13.0",
  "private": true,
  "description": "GageQuery: an interactive SQL course that runs and checks every query in the learner's browser.",
  "author": "Gabriel Agedah",
  "scripts": {
    "data": "node scripts/py.js datasets/generate.py",
    "content": "node scripts/py.js scripts/build_content.py",
    "assemble": "node scripts/py.js scripts/assemble.py",
    "build": "npm run content && npm run assemble",
    "serve": "node scripts/py.js scripts/serve.py",
    "test": "node scripts/py.js -m pytest",
    "test:fast": "node scripts/py.js -m pytest -m \"not browser\""
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "codemirror": "6.0.2",
    "sql.js": "1.15.2",
    "terser": "5.51.2"
  },
  "engines": {
    "node": ">=18"
  }
}
